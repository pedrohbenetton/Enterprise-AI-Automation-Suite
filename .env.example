# =====================================================================
# Enterprise AI Automation Suite — variáveis de ambiente
# Copie para .env e preencha:  cp .env.example .env
# NUNCA versione o arquivo .env.
# =====================================================================

# --- n8n ---------------------------------------------------------------
N8N_VERSION=2.45.7
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_HOST_PORT=5678
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_WORKER_CONCURRENCY=5
N8N_PAYLOAD_SIZE_MAX=32
EXECUTIONS_DATA_MAX_AGE=336
TZ=America/Sao_Paulo
# Gere com:  openssl rand -hex 32   (ou: ./scripts/generate-secrets.sh)
# ATENÇÃO: trocar esta chave depois invalida todas as Credentials salvas.
N8N_ENCRYPTION_KEY=change-me

# Token dos webhooks: use o MESMO valor na credential "Inbound Webhook Auth" (Header Auth) do n8n.
# Não é lido pelos containers — só pelo scripts/smoke-test.sh.
WEBHOOK_AUTH_HEADER=X-Webhook-Token
WEBHOOK_AUTH_TOKEN=change-me

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5432
N8N_DB_NAME=n8n
# Banco de negócio (faturas, leads, DLQ) com usuário de menor privilégio
APP_DB_NAME=automation
APP_DB_USER=automation_app
APP_DB_PASSWORD=change-me

# --- Redis -------------------------------------------------------------
REDIS_PASSWORD=change-me

# --- LLM (os modelos são config; a API key vai em Credentials do n8n) -----
LLM_PRIMARY_MODEL=claude-sonnet-5-5
LLM_FALLBACK_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=30000

# --- Fluxo A: triagem de leads/tickets --------------------------------
TRIAGE_URGENCY_THRESHOLD=0.75
SLACK_CHANNEL_CRITICAL=#leads-criticos
SLACK_CHANNEL_DEFAULT=#leads-inbound
SLACK_CHANNEL_OPS=#automation-ops
# Opcional: endpoint GET ?domain=<dominio> (Clearbit/Apollo/PDL ou proxy próprio).
# Vazio = só heurística local. A API key vai na credential "Enrichment API Key".
ENRICHMENT_API_URL=
# IDs de pipeline/estágio do seu portal HubSpot (Settings > Objects)
HUBSPOT_TICKET_PIPELINE=0
HUBSPOT_TICKET_STAGE=1
HUBSPOT_DEAL_PIPELINE=default
HUBSPOT_DEAL_STAGE=appointmentscheduled

# --- Fluxo B: extração de faturas -------------------------------------
INVOICE_MAX_FILE_MB=10
# Abaixo desta confiança (0-1) a extração vai para quarentena
INVOICE_MIN_CONFIDENCE=0.7
# Visão/PDF é mais lento que texto: timeout próprio
INVOICE_LLM_TIMEOUT_MS=90000
SLACK_CHANNEL_FINANCE=#financeiro-revisao
# ID da planilha (trecho da URL entre /d/ e /edit). Vazio = não grava no Sheets.
# A aba precisa ter cabeçalho: invoice_id, processed_at, issue_date, due_date, supplier_name,
# supplier_tax_id, invoice_number, currency, subtotal, tax_total, total, items_count, extractor, confidence, file_name
GSHEETS_INVOICES_DOC_ID=
GSHEETS_INVOICES_SHEET=Invoices
